# Copy to Railway Variables (do NOT commit real secrets).
# Required
TELEGRAM_BOT_TOKEN=
# One or more comma-separated numeric Telegram user IDs, e.g. 123,456.
# The first id is the owner (full access). Extra ids (also grantable at
# runtime with /allow) get an isolated personal chat session only: prompts
# and answers, no settings, no commands. Scheduled results go to the first id.
TELEGRAM_ALLOWED_USER_ID=
OPENCODE_SERVER_PASSWORD=

# Model (must match opencode.json)
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=muse-spark-1.3-contributor-free

# Optional fast model for inline/guest answers (change anytime with /inlinemodel).
# Defaults to opencode/muse-spark-1.2-contributor-free. For video understanding use a
# model with video input, e.g. opencode/muse-spark-1.3-contributor-free.
# INLINE_MODEL_PROVIDER=opencode
# INLINE_MODEL_ID=muse-spark-1.2-contributor-free

# Optional server auth username (default: opencode)
# OPENCODE_SERVER_USERNAME=opencode

# Optional bot tuning (defaults in code)
# MESSAGE_FORMAT_MODE=markdown
# LOG_LEVEL=info
# Auto-compact the session when context usage crosses this percent (1-100).
# 0 disables. Skipped while a question/permission is pending or prompts are queued.
# AUTO_COMPACT_THRESHOLD_PERCENT=0
# Supported locales: en, ar, de, es, fa, fr, id, it, ko, pt, ru, tr, zh
# BOT_LOCALE=en
# SESSIONS_LIST_LIMIT=10
# CODE_FILE_MAX_SIZE_KB=100
# OUTPUT_FILE_ENABLED=true
# OUTPUT_FILE_THRESHOLD_CHARS=20000

# Optional GitHub access for the agent (fine-grained PAT, Contents:read/write)
# Leave empty to disable git push.
# IMPORTANT: these must be visible to the `opencode serve` process, not just the bot.
# On Railway they share env. On local Docker (OpenCode on host), export them on the
# host before starting the server: export GH_TOKEN=... GIT_USER_NAME=... GIT_USER_EMAIL=...
# GH_TOKEN=
# GIT_USER_NAME=opencode-bot
# GIT_USER_EMAIL=opencode-bot@local

# Optional agent context prepended to every prompt as [Note: ...].
# Default tells the model it talks via Telegram and has GH_TOKEN for git push.
# Set to false/0/off to disable, or custom text to override.
# AGENT_CONTEXT_NOTE=

# Optional voice transcription (Whisper-compatible API, e.g. Groq).
# STT_API_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=
# STT_REQUEST_FORMAT=multipart

# Optional spoken replies (/settings to choose off/all/auto).
# TTS_PROVIDER=openai
# TTS_API_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy

# Optional document text extraction for PDF/DOCX/PPTX (external API).
# DOC_EXTRACTOR_URL=
# DOC_EXTRACTOR_API_KEY=

# Optional connectivity (pick at most one proxy mode).
# TELEGRAM_PROXY_URL=
# TELEGRAM_API_ROOT=
# TELEGRAM_FORCE_IPV4=false

# Optional list sizes and limits (defaults in code).
# TASK_LIMIT=10
# MODELS_LIST_LIMIT=10
# INITIAL_SETTINGS_PRESET={}

# Set by Railway automatically, do not set manually
# PORT=4096
# OPENCODE_API_URL is derived from PORT in entrypoint.railway.sh
